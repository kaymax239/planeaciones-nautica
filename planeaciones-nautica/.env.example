# Proveedor único de IA: GEMINI (servidor). NUNCA se expone al navegador.
# Copia este archivo a .env.local y rellena la clave.

# Clave de API de Google Gemini (https://aistudio.google.com/apikey). Requerida
# para la generación con IA. Si falta, los botones caen automáticamente a los
# generadores deterministas existentes (sin IA).
GEMINI_API_KEY=

# Modelo para Planeación F-32 Premium (enriquecimiento pedagógico).
# Por defecto: gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Modelo para Presentaciones IA (máxima calidad). Por defecto: gemini-2.5-pro.
GEMINI_MODEL_PRESENTACIONES=gemini-2.5-pro

# Clave de API de Anthropic (https://console.anthropic.com/). Requerida para las
# PRESENTACIONES (PN/MN e Inglés): esas rutas usan Claude, no Gemini. Si falta,
# los botones de presentación caen al generador determinista existente.
ANTHROPIC_API_KEY=

# Modelo de Claude para presentaciones. Por defecto: claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# ─────────────────────────────────────────────────────────────────────────────
# AUTENTICACIÓN (Firebase) Y LÍMITES DE USO
# ─────────────────────────────────────────────────────────────────────────────
# Configuración PÚBLICA del cliente web (Firebase → Configuración del proyecto →
# "Tus apps" → App web). NO es secreta: identifica el proyecto. Sin ella, la app
# muestra "acceso no configurado".
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Credenciales de la CUENTA DE SERVICIO (firebase-admin, solo servidor). Se
# obtienen del JSON que descarga Firebase → Configuración → Cuentas de servicio →
# "Generar nueva clave privada". SON SECRETAS.
# La private key va entre comillas y con los saltos de línea escapados como \n.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
