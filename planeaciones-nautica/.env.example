# Proveedores de IA (servidor). NUNCA se exponen al navegador.
# Copia este archivo a .env.local y rellena las claves.
#
# REPARTO ACTUAL:
#  - PRESENTACIONES (PN/MN e Inglés): GEMINI por defecto, con CLAUDE de
#    fallback automático. Ver el bloque "PRESENTACIONES" más abajo.
#  - Planeaciones, exámenes y enriquecimiento: CLAUDE.

# Clave de API de Anthropic (https://console.anthropic.com/). Requerida para
# planeaciones, exámenes y enriquecimiento, y para el FALLBACK de las
# presentaciones. Si falta, los botones caen automáticamente a los generadores
# deterministas existentes (sin IA), salvo la planeación de Inglés de los
# niveles 4-8, que responde 503 sin_api_key.
ANTHROPIC_API_KEY=

# Modelo por defecto de TODAS las tareas. Por defecto: claude-opus-5.
# Es también la vía de reversión: si la cuenta no tuviera acceso a Opus 5, fija
# aquí claude-opus-4-8 sin tocar código (el parámetro de esfuerzo, que solo
# admite la familia Claude 5, se omite solo en ese caso).
ANTHROPIC_MODEL=claude-opus-5

# Modelo por tarea (OPCIONALES). Solo afinan una tarea; si no están, se usa
# ANTHROPIC_MODEL. Útiles p. ej. para abaratar exámenes con claude-sonnet-5.
# ANTHROPIC_MODEL_PLANEACIONES=
# ANTHROPIC_MODEL_EXAMENES=
# ANTHROPIC_MODEL_PRESENTACIONES=

# ─────────────────────────────────────────────────────────────────────────────
# PRESENTACIONES (PN/MN e Inglés) — Gemini con Claude de fallback
# ─────────────────────────────────────────────────────────────────────────────
# Clave de API de Google Gemini (https://aistudio.google.com/apikey). Si falta,
# o si Gemini responde 429 / cuota agotada, la MISMA petición se reintenta
# automáticamente con Claude y el endpoint responde igual. En los logs del
# servidor queda siempre qué proveedor sirvió la respuesta.
GEMINI_API_KEY=

# Proveedor de las presentaciones: gemini | claude. Por defecto: gemini.
# Con "claude" NO hay fallback a Gemini: es una elección explícita.
# PROVEEDOR_PRESENTACIONES=gemini

# Modelo por defecto de Gemini. gemini-2.5-flash a propósito: es el que
# funciona en el plan gratuito. NO pongas un modelo *pro* si tu cuenta es
# gratuita — ese es justo el caso que devuelve 429 (límite 0) y hace que todas
# las presentaciones acaben cayendo a Claude.
GEMINI_MODEL=gemini-2.5-flash

# Modelo por tarea de Gemini (OPCIONALES). Hoy solo lo consumen las
# presentaciones; si no está, se usa GEMINI_MODEL.
# GEMINI_MODEL_PRESENTACIONES=

# ─────────────────────────────────────────────────────────────────────────────
# AUTENTICACIÓN (Firebase) Y LÍMITES DE USO
# ─────────────────────────────────────────────────────────────────────────────
# Configuración PÚBLICA del cliente web (Firebase → Configuración del proyecto →
# "Tus apps" → App web). NO es secreta: identifica el proyecto. Sin ella, la app
# muestra "acceso no configurado".
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Credenciales de la CUENTA DE SERVICIO (firebase-admin, solo servidor). Se
# obtienen del JSON que descarga Firebase → Configuración → Cuentas de servicio →
# "Generar nueva clave privada". SON SECRETAS.
# La private key va entre comillas y con los saltos de línea escapados como \n.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
